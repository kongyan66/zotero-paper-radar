{
  "name": "zotero-paper-radar",
  "type": "module",
  "version": "0.1.0-beta.5",
  "description": "Explainable paper recommendations for Zotero, with editable interest profiles, AI summaries, and one-click imports.",
  "private": true,
  "keywords": [
    "zotero",
    "zotero-plugin",
    "arxiv",
    "recommendation",
    "embedding"
  ],
  "config": {
    "addonName": "Zotero Paper Radar",
    "addonID": "zotero-arxiv-daily@kongyan66",
    "addonRef": "zotero-arxiv-daily",
    "addonInstance": "ZoteroArxivDaily",
    "prefsPrefix": "extensions.zotero.zoteroArxivDaily"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kongyan66/zotero-paper-radar.git"
  },
  "author": "kongyan66",
  "bugs": {
    "url": "https://github.com/kongyan66/zotero-paper-radar/issues"
  },
  "homepage": "https://github.com/kongyan66/zotero-paper-radar#readme",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration",
    "evaluate": "node --experimental-strip-types src/evaluation/cli.ts",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "zotero-plugin release",
    "test": "npm run test:unit",
    "test:integration": "node --experimental-strip-types --test test/integration/*.test.mts",
    "test:performance": "node --experimental-strip-types test/performance/run.ts",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.mts test/unit/**/*.test.mts",
    "test:zotero": "zotero-plugin test --no-watch",
    "typecheck": "tsc --noEmit",
    "update-deps": "npm update --save"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "dependencies": {
    "minisearch": "^7.2.0",
    "ml-kmeans": "7.0.1"
  }
}
