# Copy this file to `.env` and replace the placeholder paths.

# macOS example: /Applications/Zotero.app/Contents/MacOS/zotero
ZOTERO_PLUGIN_ZOTERO_BIN_PATH=/path/to/zotero

# Use a dedicated development profile.
ZOTERO_PLUGIN_PROFILE_PATH=/path/to/profile

# Leave empty to use the profile's default Zotero data directory.
ZOTERO_PLUGIN_DATA_DIR=

# Optional local release credential. Never commit the populated `.env` file.
# GITHUB_TOKEN=
